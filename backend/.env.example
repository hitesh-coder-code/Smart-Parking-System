# Copy to .env for local reference. When running via docker-compose these are
# already set in docker-compose.yml; when deploying to Render, set these as
# environment variables in the Render dashboard instead.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/parking
SPRING_DATASOURCE_USERNAME=parking_user
SPRING_DATASOURCE_PASSWORD=devpassword

# Must be at least 32 characters (256 bits) for HS256 JWT signing.
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_EXPIRATION_MS=86400000

# Comma-separated list of origins allowed to call the API (your deployed frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LOG (default): verification codes are printed to the backend's console/logs — no
# credentials needed, this is what you'll use for local dev and your demo video.
# SMTP: sends real emails — requires the SPRING_MAIL_* vars below to be set too.
EMAIL_MODE=LOG
EMAIL_FROM=no-reply@parking-system.local

# Only needed when EMAIL_MODE=SMTP
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

PORT=8080
